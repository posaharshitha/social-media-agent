# ─────────────────────────────────────────────────────────────────
#  Social Media Agentic AI — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# IBM watsonx.ai credentials
# Get these from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# IBM watsonx.ai project ID
# Found in your watsonx.ai project settings
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM watsonx.ai API endpoint (region-specific)
# e.g. https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model ID
# Options: ibm/granite-13b-chat-v2  |  ibm/granite-3-8b-instruct
GRANITE_MODEL_ID=ibm/granite-13b-chat-v2

# Flask secret key — change to a long random string in production
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_this_to_a_random_secret_key

# Flask environment (development | production)
FLASK_ENV=development

# Port to run the Flask app on
PORT=5000
